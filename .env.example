# COLD CASE — Environment Configuration

# Database Storage:
# Leave blank or use default for embedded SQLite (zero-setup):
DATABASE_URL=sqlite:///./cold_case.db
# Or connect to external PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/cold_case

# Knowledge Graph Engine:
# Leave blank for high-performance embedded NetworkX engine (zero-setup):
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# Or connect to local Neo4j or Neo4j Aura cloud:
# NEO4J_URI=bolt://localhost:7687

# Vector Database (ChromaDB):
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# spaCy Model:
SPACY_MODEL=en_core_web_sm
